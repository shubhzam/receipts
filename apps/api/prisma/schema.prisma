// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Case {
  id                String   @id @default(uuid(7))
  key               String   @unique
  reason            String
  amountCents       Int
  claimText         String
  factsJson         Json
  merchantShouldWin Boolean
  replies           Reply[]
  createdAt         DateTime @default(now())
}

model Reply {
  id      String @id @default(uuid(7))
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id])
  version String
  text    String
  model   String
  meta    Json?

  @@unique([caseId, version])
}

model Study {
  id                  String    @id @default(uuid(7))
  key                 String    @unique
  round               String
  replyVersion        String
  targetVotesPerCase  Int
  casesPerParticipant Int       @default(1)
  teracOpportunityId  String?   @unique
  status              String
  launchedAt          DateTime?
}

model Assignment {
  id                String   @id @default(uuid(7))
  studyId           String
  caseIds           String[]
  teracSubmissionId String   @unique
  createdAt         DateTime @default(now())

  @@index([studyId])
}

model Vote {
  id           String   @id @default(uuid(7))
  assignmentId String
  studyId      String
  caseId       String
  merchantWins Boolean
  confidence   Int
  weaknessTags String[]
  weaknessText String?
  checkPassed  Boolean
  createdAt    DateTime @default(now())

  @@unique([assignmentId, caseId])
  @@index([studyId, caseId])
}

model Order {
  id              String       @id @default(uuid(7))
  token           String       @unique
  status          String
  priceCents      Int
  intake          Json
  preview         Json
  result          Json?
  whopCheckoutId  String?
  whopPurchaseUrl String?
  whopPaymentId   String?      @unique
  paidAt          DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime     @default(now())
  events          AgentEvent[]
}

model AgentEvent {
  id        String   @id @default(uuid(7))
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  step      String
  reasoning String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orderId, createdAt])
}
